[Unit]
Description=NEXUS FABRIC server (development build)
After=network-online.target
Wants=network-online.target

[Service]
User=nexusfabric
Group=nexusfabric
Environment=NF_LISTEN=127.0.0.1:8787
Environment=NF_DATA_DIR=/var/lib/nexus-fabric
Environment=NF_KEY_FILE=/etc/nexus-fabric/master.key
Environment=NF_COOKIE_SECURE=1
ExecStart=/usr/local/bin/nf-server
Restart=on-failure
RestartSec=3
# sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
CapabilityBoundingSet=
ReadWritePaths=/var/lib/nexus-fabric
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
